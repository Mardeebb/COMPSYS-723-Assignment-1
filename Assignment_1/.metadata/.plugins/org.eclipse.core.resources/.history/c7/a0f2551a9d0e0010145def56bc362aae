#include <stdio.h>
#include <unistd.h>

#include "system.h"
#include "sys/alt_irq.h"
#include "io.h"
#include "altera_avalon_pio_regs.h"
#include "freertos/FreeRTOS.h"

#define lcd_task1_priority 13
#define lcd_task2_priority 14
#define ESC 27
#define CLEAR_LCD_STRING "[2J"


void freq_relay(){
	unsigned int temp = IORD(FREQUENCY_ANALYSER_BASE, 0);
	printf("%f Hz\n", 16000/(double)temp);
	return;
}

void lcd_task1(void* pvParameters)
{
	 while(1)
	 {
		 xSemaphoreTake(shared_lcd_sem, portMAX_DELAY);
		 fprintf(lcd, "%c%s", ESC, CLEAR_LCD_STRING);
		 fprintf(lcd, "\nLCD task 1\n");
		 xSemaphoreGive(shared_lcd_sem);
		 vTaskDelay(5000);
	 }
}
void lcd_task2(void* pvParameters)
{
	 while(1)
	 {
		 xSemaphoreTake(shared_lcd_sem, portMAX_DELAY);
		 fprintf(lcd, "%c%s", ESC, CLEAR_LCD_STRING);
		 fprintf(lcd, "\nLCD task 2\n");
		 xSemaphoreGive(shared_lcd_sem);
		 vTaskDelay(5000);
	 }
}

FILE *lcd;
int main()
{
	lcd = fopen(CHARACTER_LCD_NAME, "w");
	xTaskCreate(
		lcd_task1,
		"lcd_task1",
		TASK_STACKSIZE,
		NULL,
		lcd_task1_priority,
		NULL
	);
	xTaskCreate (
		lcd_task2,
		"lcd_task2",
		TASK_STACKSIZE,
		NULL,
		lcd_task2_priority,
		NULL
	);
	alt_irq_register(FREQUENCY_ANALYSER_IRQ, 0, freq_relay);
	while(1){
	  IOWR_ALTERA_AVALON_PIO_DATA(GREEN_LEDS_BASE, 0x55);
	  usleep(1000000);
	  IOWR_ALTERA_AVALON_PIO_DATA(GREEN_LEDS_BASE, 0xaa);
	  usleep(1000000);
	}

  return 0;
}
